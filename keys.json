{
  "global": {
    "cmd-shift-f": "layout.switch:factory"
  },
  "layout:factory": {
    "cmd-shift-f": "layout.switch:main",
    "cmd-o": "factory-header.open",
    "cmd-alt-1": "factory-ticket.tab-1",
    "cmd-alt-2": "factory-ticket.tab-2",
    "cmd-alt-3": "factory-ticket.tab-3",
    "cmd-alt-4": "factory-ticket.tab-4",
    "cmd-alt-5": "factory-ticket.tab-5",
    "cmd-alt-6": "factory-ticket.tab-6",
    "cmd-alt-7": "factory-ticket.view-overview",
    "cmd-alt-8": "factory-ticket.view-chat",
    "cmd-alt-9": "factory-ticket.view-diff",
    "cmd-alt-0": "factory-ticket.chat-panel",
    "cmd-1": {
      "command": "layout.select",
      "args": {
        "stack": "pages",
        "child": "home"
      }
    },
    "cmd-2": {
      "command": "layout.select",
      "args": {
        "stack": "pages",
        "child": "tickets"
      }
    },
    "cmd-3": {
      "command": "layout.select",
      "args": {
        "stack": "pages",
        "child": "reviews"
      }
    },
    "cmd-4": {
      "command": "layout.select",
      "args": {
        "stack": "pages",
        "child": "overwatch"
      }
    },
    "cmd-5": {
      "command": "layout.select",
      "args": {
        "stack": "pages",
        "child": "blueprint"
      }
    },
    "cmd-6": {
      "command": "layout.select",
      "args": {
        "stack": "pages",
        "child": "metrics"
      }
    },
    "cmd-7": {
      "command": "layout.select",
      "args": {
        "stack": "pages",
        "child": "repo-config"
      }
    },
    "cmd-8": {
      "command": "layout.select",
      "args": {
        "stack": "pages",
        "child": "config"
      }
    },
    "cmd-k": "mod.open:factory-picker",
    "cmd-j": "factory-chrome.needs-next",
    "cmd-shift-j": "factory-chrome.needs-prev"
  }
}
