      }
    },
    "cmd-4": {
      "command": "layout.select",
      "args": {
        "stack": "pages",
        "child": "overwatch"
      }
    },
    "cmd-5": {
      "command": "layout.select",
      "args": {
        "stack": "pages",
        "child": "blueprint"
      }
    },
    "cmd-6": {
      "command": "layout.select",
      "args": {
        "stack": "pages",
        "child": "metrics"
      }
    },
    "cmd-7": {
      "command": "layout.select",
