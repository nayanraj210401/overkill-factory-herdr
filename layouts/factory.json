{
  "id": "root",
  "type": "row",
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "background": "canvas",
  "theme": {
    "light": "paper",
    "dark": "factory"
  },
  "divider": {
    "width": 1,
    "color": "border"
  },
  "preview": "layouts/factory.svg",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false,
      "children": [
        {
          "id": "brand",
          "type": "block",
          "size": {
            "px": 134
          },
          "window_drag": true,
          "content": {
            "mod": "factory-chrome"
          }
        },
        {
          "id": "sidebar-tickets",
          "type": "block",
          "size": {
            "weight": 1
          },
          "min": 90,
          "content": {
            "mod": "factory-tickets"
          }
        },
        {
          "id": "sidebar-menu",
          "type": "block",
          "size": {
            "px": 250
          },
          "content": {
            "mod": "factory-menu"
          }
        },
        {
          "id": "sidebar-budget",
          "type": "block",
          "size": {
            "px": 44
          },
          "content": {
            "mod": "factory-chrome",
            "props": {
              "footer": true
            }
          }
        }
      ]
    },
    {
      "id": "work",
      "type": "column",
      "resizable": false,
      "children": [
        {
          "id": "header",
          "type": "block",
          "size": {
            "px": 42
          },
          "window_drag": true,
          "content": {
            "mod": "factory-header"
          }
        },
        {
          "id": "pages",
          "type": "stack",
          "active": "home",
          "padding": 8,
          "children": [
            {
              "id": "home",
              "type": "block",
              "content": {
                "mod": "factory-home"
              }
            },
            {
              "id": "tickets",
              "type": "block",
              "content": {
                "mod": "factory-list"
              }
            },
            {
              "id": "reviews",
              "type": "block",
              "content": {
                "mod": "factory-reviews"
              }
            },
            {
              "id": "overwatch",
              "type": "column",
              "resizable": false,
              "children": [
                {
                  "id": "overwatch-bar",
                  "type": "block",
                  "size": {
                    "px": 56
                  },
                  "content": {
                    "mod": "factory-overwatch"
                  }
                },
                {
                  "id": "overwatch-terminal",
                  "type": "block",
                  "size": {
                    "weight": 1
                  },
                  "content": {
                    "agent": "focused"
                  }
                }
              ]
            },
            {
              "id": "blueprint",
              "type": "block",
              "content": {
                "mod": "factory-blueprint"
              }
            },
            {
              "id": "metrics",
              "type": "block",
              "content": {
                "mod": "factory-metrics"
              }
            },
            {
              "id": "config",
              "type": "block",
              "content": {
                "mod": "factory-config"
              }
            },
            {
              "id": "ticket",
              "type": "block",
              "content": {
                "mod": "factory-ticket"
              }
            }
          ]
        },
        {
          "id": "status",
          "type": "block",
          "size": {
            "px": 30
          },
          "content": {
            "mod": "factory-status"
          }
        }
      ]
    }
  ]
}
